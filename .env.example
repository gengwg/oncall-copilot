# Copy to .env and fill in. .env is gitignored.

# Nebius Token Factory (https://tokenfactory.nebius.com -> API keys)
NEBIUS_API_KEY=

# Tavily (https://app.tavily.com/home)
TAVILY_API_KEY=

# Telegram bot (from @BotFather) and your chat id (from @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# OpenRouter, for the demo-video narration only (https://openrouter.ai/settings/keys)
OPENROUTER_API_KEY=
