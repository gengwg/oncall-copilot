# ~/.config/oncall-copilot/agent.env (mode 600). Read by oncall-slack-agent.service.
# Slack app "oncall-copilot (<you>)": Socket Mode on; bot scopes chat:write, im:history, im:write;
# event subscription message.im; app-level token scope connections:write.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
SLACK_OWNER_ID=U...            # your Slack user id; only this user is listened to
IRM_API_URL=https://oncall-prod-us-central-0.grafana.net/oncall
GRAFANA_URL=https://<stack>.grafana.net
IRM_PERSONAL_TOKEN=...         # your own OnCall API token (IRM > settings); acks show as you
IRM_SCHEDULE_ID=SJA3PHJ9C9AN2  # "Daily Handoff"
ONCALL_ME=U...                 # your IRM user id: GET /api/v1/users/?username=<you>
OUTBOX_DIR=/var/lib/oncall-copilot/outbox
AGENT_STATE_DIR=/home/<you>/.local/state/oncall-slack-agent   # no %h here: EnvironmentFile does not expand specifiers
CLAUDE_BIN=/home/<you>/.local/bin/claude
CLAUDE_MODEL=                  # optional, e.g. claude-sonnet-5-5: a cheaper model for the DC skill run; each run's cost is posted in the thread
METAREPO_DIR=/home/<you>/Aranya/metarepo
ACK_DRY_RUN=1                  # 0 to ack for real; start with 1 across one 08:00 PT handoff
